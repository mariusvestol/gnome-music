#!/usr/bin/python3
"""Run the local Music variant using Ubuntu's installed runtime libraries."""
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
BUILD = ROOT / '.local-build'
BUILD.mkdir(exist_ok=True)
schema = (ROOT / 'data/org.gnome.Music.gschema.xml').read_text()
schema = schema.replace('path="/org/gnome/Music/"',
                        'path="/org/gnome/Music/Mod/"')
(BUILD / 'org.gnome.Music.gschema.xml').write_text(schema)
subprocess.run(['glib-compile-schemas', '--strict', str(BUILD)], check=True)
subprocess.run([
    'glib-compile-resources', str(ROOT / 'data/org.gnome.Music.gresource.xml'),
    '--sourcedir=' + str(ROOT / 'data'),
    '--target=' + str(BUILD / 'org.gnome.Music.gresource')], check=True)
if '--build-only' in sys.argv:
    sys.exit(0)
if '--install' in sys.argv:
    applications = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share')) / 'applications'
    applications.mkdir(parents=True, exist_ok=True)
    executable = str(ROOT / 'run-local').replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%')
    desktop = '\n'.join([
        '[Desktop Entry]', 'Type=Application', 'Name=Music Mod',
        'Comment=Music with an editable queue, equalizer and crossfade',
        f'Exec="{executable}"', 'Icon=org.gnome.Music', 'Terminal=false',
        'Categories=GNOME;GTK;AudioVideo;Audio;Player;',
        'StartupNotify=true', 'StartupWMClass=org.gnome.Music.Mod', ''])
    (applications / 'org.gnome.Music.Mod.desktop').write_text(desktop)
    print('Installed Music Mod in the application menu.')
    sys.exit(0)

os.environ['GSETTINGS_SCHEMA_DIR'] = str(BUILD)
sys.path.insert(0, str(ROOT))
import gettext
gettext.bindtextdomain('org.gnome.Music', '/usr/share/locale')
gettext.textdomain('org.gnome.Music')
import gi
gi.require_versions({'Adw': '1', 'Gtk': '4.0', 'Gst': '1.0',
                     'GIRepository': '2.0'})
from gi.repository import Adw, Gio, Gst
Gst.init(None)
Adw.init()
Gio.resources_register(Gio.Resource.load(str(BUILD / 'org.gnome.Music.gresource')))
from gnomemusic.application import Application
app = Application('org.gnome.Music.Mod', '46.0 + Queue & Audio')
sys.exit(app.run(sys.argv))
